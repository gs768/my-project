# Copy this file to .env on the droplet and fill in real values.
# NEVER commit the real .env file.

PORT=8080

# Long random string clients must send as the "X-API-Key" header.
# Generate one with: openssl rand -hex 32
API_KEY=changeme-generate-a-long-random-string

# From the OAuth client ("Desktop app" type) you create in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Produced once by `npm run get-refresh-token` (see README.md).
GOOGLE_REFRESH_TOKEN=
