# Add a key for each AI engine you want to track. Engines without a key are disabled.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Optional model overrides
# OPENAI_MODEL=gpt-5
# ANTHROPIC_MODEL=claude-opus-5
# GEMINI_MODEL=gemini-2.5-flash
# PERPLEXITY_MODEL=sonar

# Sentiment: "auto" uses Claude Haiku as a judge when ANTHROPIC_API_KEY is set, "lexicon" never calls an LLM
# SENTIMENT_JUDGE=auto

PORT=3000
# Hour (server local time) for the automatic daily run, or "off"
DAILY_RUN_HOUR=6
RUN_CONCURRENCY=3
# DB_PATH=./data/beacon.db

# Set to require `Authorization: Bearer <token>` on the API/UI (recommended if exposed to the internet)
# BEACON_TOKEN=
