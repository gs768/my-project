# --- Core ---
PORT=3000
# Public base URL (used for review links and the Google OAuth redirect)
PUBLIC_URL=http://localhost:3000
# Required when deployed publicly
ADMIN_PASSWORD=change-me
SESSION_SECRET=long-random-string
# Shown in the app and on reports
AGENCY_NAME=LocalDesk
SYNC_INTERVAL_MINUTES=30
# DB_PATH=data/localdesk.db

# --- Google Business Profile (OAuth client, type "Web application") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# --- AI review replies & post writing (Claude) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# --- SMS review requests (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Email review requests & alerts (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Slack alerts for negative reviews ---
SLACK_WEBHOOK_URL=
